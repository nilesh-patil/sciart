# pixi environments
.pixi/*
!.pixi/config.toml

# Rust build output and pending snapshot reviews
/target/
# The browser player's own build (web/, WEB-R3) and the built docs site (WEB-R5)
/web/target/
/site/dist/
*.snap.new
*.pending-snap

# Local compiler cache when the home cache is unavailable
.sccache/

# Python bytecode from scripts/ (gallery, test-set parity)
__pycache__/
*.pyc


# macOS metadata
.DS_Store
**/.DS_Store
*.orig
*.rej
